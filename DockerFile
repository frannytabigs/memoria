FROM php:8.5.12-apache

# CHANGED: Added libpq-dev for PostgreSQL support
RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libpq-dev \
    zip \
    unzip \
    git \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo pdo_pgsql gd

RUN a2enmod rewrite

COPY . /var/www/html/

EXPOSE 80
