<IfModule mod_rewrite.c>
    RewriteEngine On

    # ==========================================
    # 1. ENVIRONMENT SETUP
    # ==========================================
    # HOW TO HOST:
    # -> If testing locally on XAMPP, use: RewriteBase /memoria/
    # -> If hosting on InfinityFree/Production, comment out the line above and uncomment the line below:
    
    RewriteBase /memoria/
    # RewriteBase /

    Options -Indexes

    # ==========================================
    # 2. BLOCK SENSITIVE / HIDDEN FILES
    # ==========================================
    # Instantly returns a 404 for .env, .git, and .htaccess files
    RewriteRule (^|/)\. - [R=404,L]

    # Blocks direct browser access to backend tools and passwords
    RewriteRule ^api/jwt/ - [R=404,L]
    RewriteRule ^api/config\.php$ - [R=404,L]

    # ==========================================
    # 3. API ROUTING (Environment Agnostic)
    # ==========================================
    # Automatically routes /api/users to /api/users.php 
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/([a-zA-Z0-9_-]+)(/.*)?$ api/$1.php$2 [L]

    # ==========================================
    # 4. WHITELIST (Environment Agnostic)
    # ==========================================
    # Allow the root folder
    RewriteRule ^$ - [L]

    # Allow direct access to HTML files (like index.html, dashboard.html)
    RewriteRule ^[^/]+\.html$ - [L]

    # Allow all necessary frontend assets to load securely
    RewriteRule ^assets/.*\.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff2?|ttf|json)$ - [L]

    # CRITICAL FIX: Allow the API folder (Safe because sensitive files are blocked in Step 2)
    RewriteRule ^api/ - [L]

    # ==========================================
    # 5. BLOCK EVERYTHING ELSE
    # ==========================================
    RewriteRule ^ - [R=404,L]

</IfModule>

# ==========================================
# ERROR PAGES
# ==========================================
# HOW TO HOST:
# -> If testing locally on XAMPP, leave this as-is (with /memoria/).
# -> If hosting on InfinityFree/Production, comment out the Local lines and uncomment the Production lines below.

# LOCAL HOSTING:
ErrorDocument 400 /memoria/404.html
ErrorDocument 403 /memoria/404.html
ErrorDocument 404 /memoria/404.html
ErrorDocument 500 /memoria/500.html

# PRODUCTION HOSTING:
# ErrorDocument 400 /404.html
# ErrorDocument 403 /404.html
# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html

# ==========================================
# FILE SECURITY
# ==========================================
# Double-lock to ensure the raw text and config files can never be read
<Files "logs.txt">
    Require all denied
</Files>

<Files "config.php">
    Require all denied
</Files>